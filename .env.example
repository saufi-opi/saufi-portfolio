# Payload secret — generate: openssl rand -base64 48
PAYLOAD_SECRET=change-me

# SQLite database (volume-mounted in production)
DATABASE_URI=file:./data/payload.db

# Media upload dir (volume-mounted)
MEDIA_DIR=data/media

# Public URL (used for CORS/CSRF + OG absolute URLs)
NEXT_PUBLIC_SERVER_URL=https://saufi.loxikum.xyz

# Seed script only (create initial admin user)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong
